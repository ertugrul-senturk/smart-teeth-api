# ── Required ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-long-random-string
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=smart_teeth

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0
DEBUG=False

# ── Secret separation (all default to SECRET_KEY when unset) ───────────────
# Set these individually in production so leaking one secret doesn't leak all.
# JWT_SECRET=
# BLIND_INDEX_PEPPER=
# WARNING: ENCRYPTION_SALT re-keys field encryption — existing user rows stop
# decrypting if you change it. Only set on a fresh database.
# ENCRYPTION_SALT=

# ── Desktop app access ──────────────────────────────────────────────────────
# Desktop apps authenticate with registration keys created by the master user
# (stored hashed in the database, managed from the desktop admin tab).
#
# Master registration key: accepted as a regular desktop API key AND unlocks
# the admin tab plus the /v1/admin endpoints (create / list / expire / delete
# registration keys, publish app updates). Use the same licensing format as
# generated keys, e.g.
# MASTER_REGISTRATION_KEY=A2B3C-D4E5F-G6H7J-K8L9M-N2P3Q
# Unset disables desktop sync entirely.
MASTER_REGISTRATION_KEY=

# ── Limits ──────────────────────────────────────────────────────────────────
# MAX_CONTENT_LENGTH_MB=64        # whole-request cap
# MAX_IMAGE_MB=10                 # per-image cap (413 when exceeded)
# RATELIMIT_ENABLED=True
# RATELIMIT_LOGIN=10 per minute   # login + reactivate
# RATELIMIT_RESET=5 per hour      # forgot-password + reset-password

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated origin allowlist; * allows all (default).
# CORS_ORIGINS=*

# ── Status page ─────────────────────────────────────────────────────────────
# The landing page at '/'. True (default) shows it; False hides it (404).
# Disable on a public host — it pings Mongo and reveals storage status.
# SHOW_STATUS_PAGE=True

# ── Email (password reset) ──────────────────────────────────────────────────
# Leave SMTP_HOST unset to disable sending — reset links are printed to the
# server console instead, which is enough for local testing.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Smart Teeth <you@gmail.com>
# SMTP_USE_TLS=True
# PASSWORD_RESET_URL=smart-teeth://reset-password
